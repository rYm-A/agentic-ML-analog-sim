# ==============================================================================
# Un-0 Analog ML Swarm - Compiler Worker Container
# ==============================================================================
# Target Platform: Linux x86_64 (linux/amd64) with CUDA Development Headers & PyTorch Inductor
#
# This Dockerfile defines the containerized execution environment for Compiler
# Worker nodes (Phase 1, Node 4) within the Un-0 Analog ML Swarm. It provides:
#   - Full C++ toolchain (g++, gcc, make, ninja-build) and Python headers.
#   - CUDA 12.1 development toolchain with nvcc and cuDNN 9 headers for PyTorch Inductor
#     AOT/JIT C++ code generation and Triton kernel lowering.
#   - Python 3.10.19 and Ray 2.54.0 pinned for strict wire protocol parity with the cluster head.
#   - Chia framework (chialoops) and analog simulation dependencies.
#
# ------------------------------------------------------------------------------
# Base Image & Runtime Compatibility
# ------------------------------------------------------------------------------
# Base: pytorch/pytorch:2.4.0-cuda12.1-cudnn9-devel
# - CUDA: 12.1 Devel (includes nvcc compiler and development headers)
# - Python: 3.10.19 (isolated conda env `py_worker` matching the cluster head)
# - Ray: 2.54.0 (strictly pinned to cluster head to guarantee wire protocol parity)
# - Chia: ucb-bar/chia framework (chialoops) for Ray cluster participation and MCP tools
#
# ------------------------------------------------------------------------------
# Run Options & Execution Flags
# ------------------------------------------------------------------------------
# When launching this compiler worker container (via Chia cluster manager or standalone):
#
#   1. Shared Memory:
#      --shm-size=16gb
#      Allocates 16 GB shared memory (/dev/shm) to support PyTorch Inductor code generation,
#      Triton compilation caches, and Ray Plasma Object Store exchanges.
#
#   2. File Descriptor Limit:
#      --ulimit nofile=65536:65536
#      Raises the maximum open file descriptors for ninja build parallelism and socket I/O.
#
#   3. Workspace Volume Mounts:
#      -v ${PROJECT_ROOT}:/workspace
#         Mounts the agentic-ML-analog-sim repository into the container working
#         directory for direct access to model definitions, solvers, and compiler passes.
#      -v ${PROJECT_ROOT}/results.db:/workspace/results.db
#         Persists the SQLite simulation metrics and token usage database.
#      -v ~/.cache/torch/inductor:/root/.cache/torch/inductor
#         Optional: persists Inductor compile cache across container lifecycles.
#
# ------------------------------------------------------------------------------
# Chia Cluster Configuration Reference (e.g. cluster.cloud.yaml)
# ------------------------------------------------------------------------------
# available_node_types:
#   gpu_compiler_worker:
#     resources: {"compile_worker": 1, "nvidia_gpu": 1}
#     num_workers: 1
#     compatible_ips: ["@sim_gpu_pool:0"]
#     docker:
#       image: "ghcr.io/ucb-bar/chia-compiler-worker:latest"
#       container_name: "chia-compiler-worker-${USER}"
#       pull_before_run: false
#       run_options:
#         - --shm-size=16gb
#         - --ulimit nofile=65536:65536
#         - -v ${PWD}:/workspace
#
# ------------------------------------------------------------------------------
# Build Instructions (Targeting Linux x86_64)
# ------------------------------------------------------------------------------
# NOTE: DO NOT run docker build automatically during agent swarm execution!
# Manual build command:
#   docker buildx build \
#       --platform linux/amd64 \
#       -f dockerfiles/CompilerWorkerDockerfile \
#       -t ghcr.io/ucb-bar/chia-compiler-worker:latest \
#       --load .
#
# ------------------------------------------------------------------------------
# Standalone Smoke Test
# ------------------------------------------------------------------------------
#   docker run --rm -it \
#       --platform linux/amd64 \
#       --shm-size=16gb \
#       --ulimit nofile=65536:65536 \
#       -v $(pwd):/workspace -w /workspace \
#       ghcr.io/ucb-bar/chia-compiler-worker:latest \
#       python -c "import torch, ray, chia; print('PyTorch version:', torch.__version__, '| Ray:', ray.__version__, '| CXX Compiler available')"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base Image: PyTorch 2.4.0 with CUDA 12.1 Devel and cuDNN 9 (Linux x86_64)
# ------------------------------------------------------------------------------
ARG BASE_IMAGE=pytorch/pytorch:2.4.0-cuda12.1-cudnn9-devel
FROM --platform=linux/amd64 ${BASE_IMAGE}

SHELL ["/bin/bash", "-cl"]

USER root
ENV DEBIAN_FRONTEND=noninteractive

# ------------------------------------------------------------------------------
# 2. System Toolchains & C++ Dependencies for Inductor
# ------------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        g++ \
        gcc \
        ninja-build \
        git \
        python3-dev \
        pkg-config \
        openssh-client \
        rsync \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------------------
# 3. Python 3.10.19 & Ray 2.54.0 Worker Environment (py_worker)
# ------------------------------------------------------------------------------
ARG PYTHON_VERSION=3.10.19
ARG RAY_VERSION=2.54.0

RUN /opt/conda/bin/conda create -n py_worker python=${PYTHON_VERSION} -y -q \
    && /opt/conda/bin/conda clean -afy

# ------------------------------------------------------------------------------
# 4. Compilation & Simulation Dependencies Installation
# ------------------------------------------------------------------------------
RUN /opt/conda/envs/py_worker/bin/pip install --no-cache-dir \
        "ray[default]==${RAY_VERSION}" \
        torch==2.4.0 torchvision --index-url https://download.pytorch.org/whl/cu121 \
        torchdiffeq \
        scipy \
        numpy \
        matplotlib \
        pydantic \
        anyio \
        chialoops

# ------------------------------------------------------------------------------
# 5. User Permissions & Chia Worker Provisioning Alignment
# ------------------------------------------------------------------------------
RUN id -u ray >/dev/null 2>&1 || useradd -m -s /bin/bash -u 1000 ray \
    && mkdir -p /home/ray/anaconda3/envs /workspace \
    && ln -s /opt/conda/envs/py_worker /home/ray/anaconda3/envs/py_worker \
    && chown -R ray:ray /home/ray /workspace 2>/dev/null || true \
    && chmod -R a+rwX /home/ray /workspace \
    && chmod a+rw /etc/passwd

# Configure profile environment for bash --login
RUN echo "export PATH=/opt/conda/envs/py_worker/bin:/home/ray/anaconda3/envs/py_worker/bin:\$PATH" > /etc/profile.d/00-chia-pyworker.sh \
    && echo "export CXX=g++" >> /etc/profile.d/00-chia-pyworker.sh \
    && echo "export CC=gcc" >> /etc/profile.d/00-chia-pyworker.sh \
    && echo "export TORCH_CUDA_ARCH_LIST=\"8.0;8.6;8.9;9.0+PTX\"" >> /etc/profile.d/00-chia-pyworker.sh \
    && chmod +x /etc/profile.d/00-chia-pyworker.sh

ENV PATH="/opt/conda/envs/py_worker/bin:/home/ray/anaconda3/envs/py_worker/bin:${PATH}"
ENV HOME=/home/ray
ENV CXX=g++
ENV CC=gcc

USER ray
WORKDIR /workspace

# ------------------------------------------------------------------------------
# 6. Container Execution Defaults
# ------------------------------------------------------------------------------
CMD ["/bin/bash"]
